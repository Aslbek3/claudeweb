# Ilova paroli — telefon/brauzerdan kirishda so'raladi. Buni albatta o'zgartiring.
APP_PASSWORD=change-me

# Server porti
PORT=3210

# Server qaysi interfeysda tinglaydi.
# Lokal Wi-Fi orqali (uy tarmog'i): 0.0.0.0
# VPS'da nginx orqasida (tavsiya etiladi): 127.0.0.1
HOST=0.0.0.0

# Cookie imzolash uchun tasodifiy maxfiy kalit. Masalan quyidagicha yaratish mumkin:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bo'sh qoldirsangiz avtomatik yaratiladi, lekin server har safar qayta ishga
# tushganda eski sessiyalar bekor bo'ladi — VPS uchun doimiy qiymat qo'yish tavsiya etiladi.
SESSION_SECRET=

# VPS'da nginx (yoki boshqa) reverse proxy orqasida HTTPS bilan ishlayotganda 1 qiling.
# Lokal (uy) foydalanishda 0 qoldiring.
TRUST_PROXY=0

# Claude qaysi papkada ishlaydi (fayllarni o'qish/yozish, buyruq bajarish shu yerda bo'ladi).
PROJECT_DIR=./workspace

# --- Autentifikatsiya (ikkitadan BIRINI tanlang) ---
#
# 1-yo'l (lokal kompyuterda, Claude Pro/Max obunangiz bo'lsa):
#   Terminalda "claude login" qiling. VPS'da (headless) bu usul noqulay.
#
# 2-yo'l: Anthropic Console'dan API kalit oling (console.anthropic.com):
# ANTHROPIC_API_KEY=sk-ant-...
